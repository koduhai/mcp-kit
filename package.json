{
  "name": "@koduhai/mcp-kit",
  "version": "0.3.0",
  "description": "Auth and versioning for MCP servers, solved. Upstream API auth (API key / bearer / OAuth client-credentials), API versioning with a get_version tool, and a one-call OAuth 2.1 Resource Server (JWKS + introspection verifiers, RFC 9728 metadata) on top of the MCP SDK.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "oauth",
    "oauth2",
    "authorization",
    "jwt",
    "jwks",
    "token-introspection",
    "ai-agents",
    "llm",
    "versioning"
  ],
  "license": "MIT",
  "author": "Koduhai",
  "homepage": "https://github.com/koduhai/mcp-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koduhai/mcp-kit.git"
  },
  "bugs": {
    "url": "https://github.com/koduhai/mcp-kit/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./upstream": {
      "types": "./dist/upstream/index.d.ts",
      "import": "./dist/upstream/index.js"
    },
    "./versioning": {
      "types": "./dist/versioning/index.d.ts",
      "import": "./dist/versioning/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "check:exports": "publint && attw --pack . --profile esm-only",
    "docs": "typedoc",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.20.0",
    "express": "^4.19.0 || ^5.0.0",
    "jose": "^5.9.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "jose": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/express": "^5.0.0",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.0.0",
    "jose": "^6.0.0",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "supertest": "^7.0.0",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
